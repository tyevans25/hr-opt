# ──────────────────────────────────────────────
# LLM Provider
# Set LLM_PROVIDER to one of: ollama | anthropic | gsu
# ──────────────────────────────────────────────
LLM_PROVIDER=ollama

# Ollama (local) — only needed if LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic Claude — only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# GSU hosted model — only needed if LLM_PROVIDER=gsu
GSU_BASE_URL=https://...
GSU_MODEL=...
GSU_API_KEY=...

# ──────────────────────────────────────────────
# Databases (Docker defaults — change for production)
# ──────────────────────────────────────────────
POSTGRES_URL=postgresql://hropt:hropt123@localhost:5432/hropt
QDRANT_URL=http://localhost:6333

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ──────────────────────────────────────────────
# Email (optional — not yet wired up)
# ──────────────────────────────────────────────
RESEND_API_KEY=
